## dnscrypt-proxy Configuration Template for GhostRoute
## Generated at runtime — do not edit manually

# Encrypted DNS server list
server_names = ['cloudflare', 'cloudflare-ipv6', 'quad9-dnscrypt-ip4-filter-pri']

# Listen address for local DNS queries from GhostRoute
listen_addresses = ['127.0.0.1:5300']

# Maximum number of simultaneous DNS queries
max_clients = 250

# Use Tor-routed DNS if available
# proxy = 'socks5://127.0.0.1:9050'

# Don't send client info to resolvers
ipv6_servers = false
dnscrypt_servers = true
doh_servers = true

# Block known malicious domains
block_ipv6 = true
block_unqualified = true
block_undelegated = true

# Cache settings
cache = true
cache_size = 4096
cache_min_ttl = 2400
cache_max_ttl = 86400

# Log settings (minimal)
log_level = 2

# Source for server list
[sources.public-resolvers]
  urls = ['https://raw.githubusercontent.com/DNSCrypt/dnscrypt-resolvers/master/v3/public-resolvers.md']
  minisign_key = 'RWQf6LRCGA9i53mlYecO4IzT51TGPpvWucNSCh1CBM0QTaLn73Y7GFO3'
  cache_file = '/tmp/ghostroute-dnscrypt/public-resolvers.md'
  refresh_delay = 72
